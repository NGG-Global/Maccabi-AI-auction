# Supabase — the shared NGG project; this app's tables live in the `auction` schema.
# Public anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — service role key (server-side only, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Staff login (/admin): any @nggconsult.com e-mail + this shared password.
# Compared in constant time; failed attempts are rate-limited per IP.
NGG_STAFF_PASSWORD=change-me-before-event

# Signs the staff session cookie (HMAC-SHA256). At least 16 characters;
# generate with: openssl rand -base64 32
NGG_SESSION_SECRET=change-me-to-a-long-random-string

# Integration tests only (tests/integration): a LOCAL Postgres with the
# migrations applied. Never the shared project.
# DATABASE_URL=postgres://postgres@127.0.0.1:54329/auction_test
